# Copy to .env and edit. Anything here can also be set per-invocation:
#   DEVBOX_NAME=box2 DEVBOX_WORKSPACE=~/work/box2 ./scripts/devbox up

# Container + compose project name. Change it to run a second box.
DEVBOX_NAME=lance-devbox

# Host directory bind-mounted at /workspace. Put your lance checkout in here.
# Give each box its own, so each gets its own target/ directories.
DEVBOX_WORKSPACE=./workspace

DEVBOX_IMAGE=ghcr.io/westonpace/lance-weston-devbox:latest

# Shared compilation cache. Worth turning on once two or more boxes are up.
# RUSTC_WRAPPER=sccache
# SCCACHE_CACHE_SIZE=50G

# Leave empty for "all cores". Set a number when several boxes build at once.
# CARGO_BUILD_JOBS=16
