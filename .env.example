# Copy to .env and edit. Anything here can also be set per-invocation:
#   DEVBOX_NAME=box2 DEVBOX_WORKSPACE=~/work/box2 ./scripts/devbox up

# Container + compose project name. Change it to run a second box.
DEVBOX_NAME=lance-devbox

# Host directory bind-mounted at /workspace. Put your lance checkout in here.
# Give each box its own, so each gets its own target/ directories.
DEVBOX_WORKSPACE=./workspace

DEVBOX_IMAGE=ghcr.io/westonpace/lance-weston-devbox:latest

# --- rust build cache (mr boxington) ----------------------------------------
# The local action store is shared between boxes automatically; nothing to turn
# on. These only matter if you want more than the defaults.

# Combined budget for the action store, managed targets and incremental state.
# MBX_GC_MAX_TOTAL_SIZE=50GiB

# Remote cache. Leave unset for a laptop. On the EC2 host, point it at the
# bucket and give the instance role s3:GetObject/PutObject on that prefix plus
# s3:ListBucket on the bucket -- mbx reads IMDSv2 itself, no credentials here.
# MBX_REMOTE_URL=s3://lance-build-cache/devbox
# MBX_REMOTE_NAMESPACE=lance
# MBX_REMOTE_S3_REGION=us-east-1

# Boxes publish to the bucket by default (compose sets MBX_REMOTE_TRUST_WRITES,
# without which mbx treats any non-CI shell as read-only). Flip this for a box
# that should only consume what others built.
# MBX_REMOTE_MODE=read-only

# Leave empty for "all cores". Set a number when several boxes build at once.
# CARGO_BUILD_JOBS=16
